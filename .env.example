# =============================================================================
# Observability Stack — Environment Configuration
# =============================================================================

# Grafana Admin Credentials
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-this-secure-password

# Grafana Faro Web SDK (Browser RUM) CORS Origins
# Comma-separated list of allowed frontend origins (use * for development/testing)
FARO_CORS_ALLOWED_ORIGINS=http://localhost:5173,https://app.example.com

# Prometheus Data Retention (default: 15 days)
PROMETHEUS_RETENTION=15d

# Host Port Mappings (Optional overrides)
GRAFANA_PORT=3000
OTLP_GRPC_PORT=4317
OTLP_HTTP_PORT=4318
FARO_PORT=12347
ALLOY_UI_PORT=12345
