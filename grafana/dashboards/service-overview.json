{
  "uid": "service-overview",
  "title": "Service Overview (OTel)",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "job",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(target_info, job)",
          "refId": "job"
        },
        "definition": "label_values(target_info, job)",
        "includeAll": true,
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "refresh": 2
      }
    ]
  },
  "panels": [
    {
      "type": "timeseries",
      "title": "HTTP requests/s by route",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "{{http_request_method}} {{http_route}}",
          "expr": "sum by (http_request_method, http_route) (rate(http_server_request_duration_seconds_count{job=~\"$job\"}[$__rate_interval]))"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "HTTP p95 latency by route",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "{{http_route}}",
          "expr": "histogram_quantile(0.95, sum by (le, http_route) (rate(http_server_request_duration_seconds_bucket{job=~\"$job\"}[$__rate_interval])))"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "HTTP 5xx ratio",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "5xx ratio",
          "expr": "sum(rate(http_server_request_duration_seconds_count{job=~\"$job\", http_response_status_code=~\"5..\"}[$__rate_interval])) / clamp_min(sum(rate(http_server_request_duration_seconds_count{job=~\"$job\"}[$__rate_interval])), 1e-9)"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "DB query p95 by table/operation",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "{{db_operation}} {{db_table}}",
          "expr": "topk(15, histogram_quantile(0.95, sum by (le, db_operation, db_table) (rate({__name__=~\".*db_query_duration_seconds_bucket\", job=~\"$job\"}[$__rate_interval]))))"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Service method p95 (top 15)",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "{{module}}.{{method}}",
          "expr": "topk(15, histogram_quantile(0.95, sum by (le, module, method) (rate({__name__=~\".*method_duration_seconds_bucket\", job=~\"$job\"}[$__rate_interval]))))"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Service method error rate",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "{{module}}.{{method}}",
          "expr": "topk(10, sum by (module, method) (rate({__name__=~\".*method_duration_seconds_count\", job=~\"$job\", outcome=\"error\"}[$__rate_interval])))"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "River job work p95",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 24
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "{{kind}}",
          "expr": "histogram_quantile(0.95, sum by (le, kind) (rate(river_work_duration_histogram_seconds_bucket{job=~\"$job\"}[$__rate_interval])))"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "SSE connections",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 24
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "{{job}}",
          "expr": "sum by (job) ({__name__=~\".*(sse_connections|active_connections).*\", job=~\"$job\"})"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Go goroutines / heap",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 24
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "goroutines {{job}}",
          "expr": "sum by (job) (go_goroutine_count{job=~\"$job\"})"
        },
        {
          "refId": "B",
          "legendFormat": "memory used {{job}}",
          "expr": "sum by (job) (go_memory_used_bytes{job=~\"$job\"})"
        }
      ]
    },
    {
      "type": "logs",
      "title": "Error logs",
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 32
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{service_namespace=~\".+\"} | severity_text=~\"ERROR|error|WARN|warn\""
        }
      ]
    }
  ]
}